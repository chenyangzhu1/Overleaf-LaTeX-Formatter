{
  "manifest_version": 3,
  "name": "Overleaf LaTeX Formatter",
  "version": "0.2.0",
  "description": "Format the active LaTeX file in Overleaf via toolbar or in-page button.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.overleaf.com/*",
    "https://*.overleaf.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Format LaTeX",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "format_latex": {
      "suggested_key": {
        "default": "Alt+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Format current LaTeX file in Overleaf"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.overleaf.com/*",
        "https://*.overleaf.com/*"
      ],
      "js": [
        "src/shortcut.js",
        "src/floating-button-position.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/editor-target.js",
        "src/formatter.js",
        "src/injected.js"
      ],
      "matches": [
        "https://www.overleaf.com/*",
        "https://*.overleaf.com/*"
      ]
    }
  ]
}
